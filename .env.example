# VSoftSol GTM Engine — environment template
# Copy to .env (NEVER commit .env). Every variable below is REQUIRED unless marked optional.
# The application must refuse to start if any required value is missing or malformed.

# ---- Core ----
VGE_ENV=                       # dev | staging | production
VGE_LOG_LEVEL=INFO
VGE_SECRET_KEY=                # 32+ random bytes, base64
VGE_BASE_URL=                  # internal console URL via the tunnel

# ---- Database ----
DATABASE_URL=                  # postgresql+psycopg://user:pass@host:5432/vge?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ---- Redis ----
REDIS_URL=                     # redis://:password@127.0.0.1:6379/0

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_DAILY_COST_CEILING_USD=    # hard stop, not a warning

# ---- GitHub (website publishing) ----
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=       # or GITHUB_TOKEN for fine-grained PAT
GITHUB_SITE_REPO=              # owner/repo
GITHUB_SITE_BASE_BRANCH=main
GITHUB_ALLOW_DIRECT_PUSH=false # must remain false

# ---- Vercel ----
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# ---- Email ----
EMAIL_GATEWAY=draft_only       # draft_only | smtp | api
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_PHYSICAL_ADDRESS=        # required by CAN-SPAM/CASL, blocks send if empty
EMAIL_PROVIDER_API_KEY=        # optional until go-live
EMAIL_SEND_GUARD=true          # true in dev/staging; false ONLY in production
EMAIL_ALLOWLIST=               # comma-separated, used when send guard is on

# ---- Social (optional until Phase D8/D10) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
SOCIAL_DRY_RUN=true

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_SHIP_ENDPOINT=
LOG_SHIP_TOKEN=
METRICS_ENABLED=true

# ---- Storage ----
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---- Safety switches (never default to permissive) ----
REQUIRE_HUMAN_APPROVAL=true    # must remain true
EMERGENCY_STOP=false
